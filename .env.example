# ===== LLM 配置（阶段 2 用）=====
# 二选一：智谱 GLM 或 DeepSeek，均使用 OpenAI 兼容接口
# 智谱开放平台：https://open.bigmodel.cn
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_zhipu_api_key_here
LLM_MODEL=glm-4.5

# DeepSeek 示例（取消注释切换）
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat

# ===== TTS 配置（阶段 3 用，edge-tts 默认免费无需 key）=====
# edge-tts 中文音色，可选：
#   zh-CN-XiaoyiNeural   (女声，活泼，推荐流萤)
#   zh-CN-XiaoxiaoNeural (女声，温柔)
#   zh-CN-XiaohanNeural  (女声，温柔深沉)
TTS_VOICE=zh-CN-XiaoyiNeural

# ===== Embedding 配置（阶段 5 长期记忆用，智谱 GLM）=====
# DeepSeek 不提供 embedding，记忆系统用智谱 embedding-3（OpenAI 兼容，注册送额度）
# 在 https://open.bigmodel.cn 注册获取
ZHIPU_API_KEY=在这里粘贴你的智谱 API Key（可选，不填则不记忆）
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
